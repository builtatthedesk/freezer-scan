# Copy to .env in the repo folder and fill in. Never commit .env.
# Two passwords: letters, numbers, _ and -, at least 16 characters, different from each other.
WRITE_KEY=
READ_KEY=
# Your time zone, for the dates on new labels.
TZ_NAME=America/New_York
# VPS only: the domain Caddy should get a certificate for.
DOMAIN=freezer.example.com
