# Copy to .env in the repo folder and fill in. Never commit .env.
# Two passwords: letters, numbers, _ and -, at least 16 characters, different from each other.
WRITE_KEY=
READ_KEY=
# Your time zone, for the dates on new labels.
TZ_NAME=America/New_York
# Optional: turns on "From a photo" label suggestions (Claude API key).
ANTHROPIC_API_KEY=
# VPS only: the domain Caddy should get a certificate for.
DOMAIN=freezer.example.com

# Retire a copy without deleting it: FROZEN=1 serves the list read-only and refuses
# every write with 403, so an old bookmark can't scan into a list nobody reads.
# The demo (DEMO=1) stays writable. FROZEN_NOTE replaces the message people see --
# name the address the real list moved to.
#FROZEN=1
#FROZEN_NOTE=This copy is frozen. The list moved to https://your-new-address/
